// SimulationOS - fastfetch
//
// The logo is "SimOS" as a dot matrix of binary digits, followed by the name
// in ASCII binary. It is generated by scripts/make-branding.py.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/simulationos/fastfetch/logo.txt",
    "color": {
      "1": "bright_cyan",
      "2": "38;5;238",
      "3": "cyan"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
